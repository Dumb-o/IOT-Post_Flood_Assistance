              "type": "SIMPLE",
              "filters": [
                {
                  "argument": "turbidity",
                  "valueType": "NUMERIC",
                  "predicates": [
                    {
                      "type": "NUMERIC",
                      "operation": "GREATER",
                      "value": {
                        "staticValue": 50.0
                      }
                    }
                  ]
                }
              ],
              "operation": "AND"
            }
          },
          "alarmDetails": "Turbidity above 50 NTU: chlorination efficacy compromised"
        }
      },
      "clearRule": {
        "condition": {
          "type": "DURATION",
          "unit": "SECONDS",
          "value": {
            "staticValue": 30
          },
          "expression": {
            "type": "SIMPLE",
            "filters": [
              {
                "argument": "turbidity",
                "valueType": "NUMERIC",
                "predicates": [
                  {
                    "type": "NUMERIC",
                    "operation": "LESS",
                    "value": {
                      "staticValue": 40.0
                    }
                  }
