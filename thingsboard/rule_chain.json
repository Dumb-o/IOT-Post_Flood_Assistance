          "scriptLang": "TBEL",
          "alarmDetailsBuildJs": "return {};",
          "alarmDetailsBuildTbel": "var details = {};\ndetails.reason = 'no telemetry within the inactivity timeout';\nif (metadata.lastActivityTime != null) { details.lastActivityTime = metadata.lastActivityTime; }\nreturn details;",
