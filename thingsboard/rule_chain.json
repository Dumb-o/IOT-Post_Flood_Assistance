      {
        "type": "org.thingsboard.rule.engine.transform.TbTransformMsgNode",
        "name": "Alarm -> alm_* attribute",
        "debugSettings": {
          "failuresEnabled": true,
          "allEnabled": false,
          "allEnabledUntil": 0
        },
        "singletonMode": false,
        "queueName": null,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "TBEL",
          "jsScript": "return {msg: msg, metadata: metadata, msgType: msgType};",
          "tbelScript": "// JalDrishti: mirror each alarm into a server attribute alm_<kind> = severity | NONE.\n// The map marker colour, the status table and the node detail view read these keys.\nvar keys = {\"High Turbidity\": \"alm_turbidity_warn\", \"Gross Contamination\": \"alm_turbidity_crit\", \"pH Out of Range\": \"alm_ph\", \"High TDS\": \"alm_tds\", \"Supply Interruption\": \"alm_flow\", \"Node Inactive\": \"alm_inactive\"};\nvar k = keys[msg.type];\nif (k == null) { k = 'alm_other'; }\nvar st = msg.status;\nvar cleared = msgType == 'ALARM_CLEAR' || metadata.isClearedAlarm == 'true' || msg.cleared == true\n              || (st != null && st.startsWith('CLEARED'));\nvar out = {};\nout[k] = cleared ? 'NONE' : msg.severity;\nout[k + '_ts'] = cleared ? msg.clearTs : msg.createdTime;\nreturn {msg: out, metadata: metadata, msgType: 'POST_ATTRIBUTES_REQUEST'};"
        },
        "additionalInfo": {
          "description": "",
          "layoutX": 920,
          "layoutY": 320
        }
      },
      {
        "type": "org.thingsboard.rule.engine.telemetry.TbMsgAttributesNode",
        "name": "Save Server Attributes",
        "debugSettings": {
